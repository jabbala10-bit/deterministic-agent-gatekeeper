{
  "manifest_version": 3,
  "bundle": "bank-servicing",
  "principal_type": "Agent",
  "labels": ["private_data", "untrusted_input"],
  "counters": {
    "refunded_minor": {"max": 100000000}
  },
  "action_groups": ["Egress", "Read"],
  "config_entity_types": {
    "RecipientGroup": {"member_of": []},
    "DomainSuffix": {"member_of": ["RecipientGroup"]},
    "HostGroup": {"member_of": []},
    "HostSuffix": {"member_of": ["HostGroup"]}
  },
  "snapshot_entity_types": {
    "Account": {"frozen": "bool"}
  },
  "tools": {
    "payments.refund": {
      "groups": [],
      "resource": {"type": "Account", "from": "account_id"},
      "args": {
        "account_id": {"type": "id"},
        "amount": {"type": "money", "currencies": ["EUR", "JPY", "USD"], "min_minor": 1, "max_minor": 100000000}
      },
      "budget": {"counter": "refunded_minor", "from": "amount", "field": "amount_minor"},
      "result_labels": []
    },
    "email.send": {
      "groups": ["Egress"],
      "resource": {"type": "Recipient", "from": "to", "field": "domain",
                   "parents": {"type": "DomainSuffix", "derive": "host_suffixes"}},
      "args": {
        "to": {"type": "email"},
        "subject": {"type": "text", "max_len": 200},
        "body": {"type": "text", "max_len": 20000}
      },
      "result_labels": []
    },
    "web.fetch": {
      "groups": ["Egress"],
      "resource": {"type": "Host", "from": "url", "field": "host",
                   "parents": {"type": "HostSuffix", "derive": "host_suffixes"}},
      "args": {
        "url": {"type": "url", "schemes": ["https"], "allow_ip": false}
      },
      "result_labels": ["untrusted_input"]
    },
    "db.report": {
      "groups": [],
      "resource": {"type": "Report", "from": "report", "field": "name"},
      "args": {
        "report": {
          "type": "template",
          "templates": {
            "refund_summary": {"params": {"account_id": {"type": "id"}, "since_days": {"type": "int", "min": 1, "max": 90}}},
            "customer_balance": {"params": {"customer_id": {"type": "id"}}},
            "pii_export": {"params": {"customer_id": {"type": "id"}}}
          }
        }
      },
      "result_labels": ["private_data"]
    },
    "crm.lookup": {
      "groups": ["Read"],
      "resource": {"type": "Customer", "from": "customer_id"},
      "args": {"customer_id": {"type": "id"}},
      "result_labels": ["private_data"]
    },
    "inbox.read": {
      "groups": ["Read"],
      "resource": {"type": "Mailbox", "from": "mailbox_id"},
      "args": {"mailbox_id": {"type": "id"}},
      "result_labels": ["untrusted_input"]
    }
  }
}
